{
  "expo": {
    "name": "Caregivers For Tomorrow",
    "slug": "caregivers-for-tomorrow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "caregivers",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "th.skoutlier.caregivers"
    },
    "android": {
      "package": "th.skoutlier.caregivers",
      "adaptiveIcon": {
        "backgroundColor": "#E6F7F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E9F9F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ใช้ตำแหน่งเพื่อยืนยันการเช็คอิน/เช็คเอาท์ของผู้ดูแลที่บ้านผู้ใช้บริการ"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
